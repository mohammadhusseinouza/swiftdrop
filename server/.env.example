NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign login access tokens. Generate a strong random value,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-strong-random-secret
# Duration string understood by the "ms" package (e.g. "15m", "1h").
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token is an opaque random value; only its SHA-256 digest is stored
# server-side (see auth_sessions table), so no signing secret is needed here.
# Lifetime in seconds (default 2592000 = 30 days if unset).
AUTH_REFRESH_TOKEN_EXPIRES_IN=2592000
# Name of the HttpOnly cookie carrying the raw refresh token.
AUTH_REFRESH_COOKIE_NAME=refresh_token
