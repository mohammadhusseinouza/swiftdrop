NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign login access tokens. Generate a strong random value,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-strong-random-secret
# Duration string understood by the "ms" package (e.g. "15m", "1h").
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token is an opaque random value; only its SHA-256 digest is stored
# server-side (see auth_sessions table), so no signing secret is needed here.
# Lifetime in seconds (default 2592000 = 30 days if unset).
AUTH_REFRESH_TOKEN_EXPIRES_IN=2592000
# Name of the HttpOnly cookie carrying the raw refresh token.
AUTH_REFRESH_COOKIE_NAME=refresh_token

# Public URL of the deployed client build (no trailing path). Read only by the
# financial release activation gate G7, which fetches <CLIENT_URL>/version.json.
# CLIENT_URL=https://your-client.example.com

# Settlement-based financial release cutover authorization (gate G0). Leave
# UNSET everywhere: activation is impossible unless this is exactly "true",
# and it may be set only for an explicitly authorized production cutover.
# FINANCIAL_RELEASE_ACTIVATION_AUTHORIZED=

# Driver cash historical reconciliation writes (FR.12A.5: propose / approve /
# reject / withdraw / revoke). Leave UNSET everywhere: every write is refused
# (403 HISTORICAL_RECONCILIATION_DISABLED) unless this is exactly "true", and it
# may be set only for a separately authorized maintenance window, then removed.
# Read endpoints are unaffected.
# DRIVER_CASH_HISTORICAL_RECONCILIATION_ENABLED=
