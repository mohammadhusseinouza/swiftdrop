generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model areas {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @unique @db.VarChar(150)
  is_active  Boolean     @default(true)
  sort_order Int         @default(0)
  created_at DateTime    @default(now()) @db.Timestamptz(3)
  updated_at DateTime    @default(now()) @db.Timestamptz(3)
  customers  customers[]
  orders     orders[]    @relation("orders_receiver_area")

  parcel_collection_orders orders[] @relation("orders_parcel_collection_area")
  customer_receivers       customer_receivers[]

  @@index([is_active, sort_order])
}

model audit_logs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id   String?  @db.Uuid
  action          String   @db.VarChar(100)
  entity_type     String   @db.VarChar(100)
  entity_id       String   @db.VarChar(100)
  previous_values Json?
  new_values      Json?
  metadata        Json?
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  users           users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)


  // FR.12A.3 — a surviving audit cited as historical reconciliation evidence.
  historical_reconciliations driver_cash_historical_reconciliations[] @relation("dchr_source_audit_log")
  // FR.12A.9 — a surviving audit cited by a historical ownership resolution.
  historical_ownership_resolutions historical_ownership_resolutions[] @relation("hor_source_audit_log")

  @@index([action, created_at])
  @@index([actor_user_id, created_at])
  @@index([entity_type, entity_id, created_at])
}

model company_financial_transactions {
  id                                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                             String?                          @db.Uuid
  type                                 CompanyFinancialTransactionType
  amount                               Decimal                          @db.Decimal(14, 2)
  payment_method_id                    String?                          @db.Uuid
  created_by_id                        String?                          @db.Uuid
  notes                                String?
  reversal_of_id                       String?                          @db.Uuid
  idempotency_key                      String?                          @unique @db.VarChar(200)
  created_at                           DateTime                         @default(now()) @db.Timestamptz(3)
  users                                users?                           @relation(fields: [created_by_id], references: [id], onUpdate: NoAction)
  orders                               orders?                          @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment_methods                      payment_methods?                 @relation(fields: [payment_method_id], references: [id], onUpdate: NoAction)
  company_financial_transactions       company_financial_transactions?  @relation("company_financial_transactionsTocompany_financial_transactions", fields: [reversal_of_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_company_financial_transactions company_financial_transactions[] @relation("company_financial_transactionsTocompany_financial_transactions")

  // Settlement-Based Financial Release (FR.2) — inverse relations only.
  financial_release_product_posting   order_financial_releases?            @relation("ofr_company_product_transaction")
  financial_release_fee_posting       order_financial_releases?            @relation("ofr_company_fee_transaction")
  release_correction_product_reversal order_financial_release_corrections? @relation("ofrc_company_product_reversal")
  release_correction_fee_reversal     order_financial_release_corrections? @relation("ofrc_company_fee_reversal")

  @@index([created_at])
  @@index([order_id])
  @@index([type, created_at])
}

/// Direct Payment Settlement — append-only record of money collected at
/// delivery with a bypass_driver_cash payment method, i.e. received DIRECTLY
/// by the company. Not revenue (company_financial_transactions), not Driver
/// Cash (no balance, no settlement obligation), not the customer wallet.
/// CHECK (amount > 0) lives only in the SQL migration
/// (migrations/2026-09-23__0923__payment_method_bypass_driver_cash.sql).
model company_direct_collections {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id          String          @db.Uuid
  driver_id         String?         @db.Uuid
  payment_method_id String          @db.Uuid
  amount            Decimal         @db.Decimal(14, 2)
  created_by_id     String?         @db.Uuid
  notes             String?
  idempotency_key   String?         @unique @db.VarChar(200)
  created_at        DateTime        @default(now()) @db.Timestamptz(3)
  orders            orders          @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  drivers           drivers?        @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment_methods   payment_methods @relation(fields: [payment_method_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users             users?          @relation(fields: [created_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([created_at])
  @@index([order_id])
  @@index([driver_id, created_at])
}

model customer_payouts {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payout_number       String               @unique @db.VarChar(50)
  customer_id         String               @db.Uuid
  amount              Decimal              @db.Decimal(14, 2)
  payment_method_id   String               @db.Uuid
  status              PayoutStatus         @default(COMPLETED)
  processed_by_id     String               @db.Uuid
  notes               String?
  created_at          DateTime             @default(now()) @db.Timestamptz(3)
  updated_at          DateTime             @default(now()) @db.Timestamptz(3)
  customers           customers            @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  payment_methods     payment_methods      @relation(fields: [payment_method_id], references: [id], onUpdate: NoAction)
  users               users                @relation(fields: [processed_by_id], references: [id], onUpdate: NoAction)
  wallet_transactions wallet_transactions?

  @@index([customer_id, created_at])
  @@index([status, created_at])
}

model customer_wallets {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id         String                @unique @db.Uuid
  available_balance   Decimal               @default(0) @db.Decimal(14, 2)
  created_at          DateTime              @default(now()) @db.Timestamptz(3)
  updated_at          DateTime              @default(now()) @db.Timestamptz(3)
  customers           customers             @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  wallet_transactions wallet_transactions[]
}

/// customer_number's default reads the `customer_number_seq` sequence (created
/// in migrations/, not visible to Prisma) — backend-generated, sequential,
/// concurrency-safe (Postgres nextval() is atomic). Never client-supplied.
model customers {
  id                                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portal_user_id                        String?               @unique @db.Uuid
  customer_number                       String                @unique @default(dbgenerated("('CUST-'::text || lpad((nextval('customer_number_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(50)
  name                                  String                @db.VarChar(200)
  primary_phone                         String                @db.VarChar(30)
  secondary_phone                       String?               @db.VarChar(30)
  email                                 String?               @db.VarChar(255)
  default_address                       String?               @db.VarChar(500)
  default_area_id                       String?               @db.Uuid
  notes                                 String?
  is_active                             Boolean               @default(true)
  created_by_id                         String                @db.Uuid
  created_at                            DateTime              @default(now()) @db.Timestamptz(3)
  updated_at                            DateTime              @default(now()) @db.Timestamptz(3)
  customer_payouts                      customer_payouts[]
  customer_wallets                      customer_wallets?
  users_customers_created_by_idTousers  users                 @relation("customers_created_by_idTousers", fields: [created_by_id], references: [id], onUpdate: NoAction)
  areas                                 areas?                @relation(fields: [default_area_id], references: [id], onUpdate: NoAction)
  users_customers_portal_user_idTousers users?                @relation("customers_portal_user_idTousers", fields: [portal_user_id], references: [id], onUpdate: NoAction)
  orders                                orders[]
  wallet_transactions                   wallet_transactions[]
  order_financial_releases              order_financial_releases[]
  customer_receivers                    customer_receivers[]

  @@index([default_area_id])
  @@index([is_active])
  @@index([name])
  @@index([primary_phone])
}

/// Customer Receiver Memory — the latest reusable receiver details a customer
/// has sent orders to, used ONLY for Create / Edit Order autocomplete.
/// Identified by (customer_id, normalized_phone). Written only inside the
/// order create / edit transactions; never backfilled. Orders keep their own
/// receiver_* snapshot columns and never read from this table, so a change
/// here never alters any order (CLAUDE.md §11).
model customer_receivers {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id       String    @db.Uuid
  name              String    @db.VarChar(200)
  /// The primary phone exactly as last entered (display value).
  phone             String    @db.VarChar(30)
  /// E.164-style matching key from normalizeReceiverPhone(); never displayed.
  normalized_phone  String    @db.VarChar(20)
  alternative_phone String?   @db.VarChar(30)
  area_id           String?   @db.Uuid
  address           String    @db.VarChar(500)
  building_floor    String?   @db.VarChar(200)
  map_link          String?   @db.VarChar(1000)
  instructions      String?
  created_at        DateTime  @default(now()) @db.Timestamptz(3)
  updated_at        DateTime  @default(now()) @db.Timestamptz(3)
  customers         customers @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  areas             areas?    @relation(fields: [area_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([customer_id, normalized_phone])
  @@index([customer_id, updated_at(sort: Desc)])
  @@index([area_id])
}

model delivery_attempts {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                String                   @db.Uuid
  driver_id               String                   @db.Uuid
  attempt_number          Int
  expected_collection     Decimal                  @db.Decimal(14, 2)
  actual_collection       Decimal?                 @db.Decimal(14, 2)
  outcome                 DeliveryAttemptOutcome
  failed_reason_id        String?                  @db.Uuid
  notes                   String?
  started_at              DateTime                 @default(now()) @db.Timestamptz(3)
  completed_at            DateTime?                @db.Timestamptz(3)
  created_at              DateTime                 @default(now()) @db.Timestamptz(3)
  drivers                 drivers                  @relation(fields: [driver_id], references: [id], onUpdate: NoAction)
  failed_delivery_reasons failed_delivery_reasons? @relation(fields: [failed_reason_id], references: [id], onUpdate: NoAction)
  orders                  orders                   @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@unique([order_id, attempt_number])
  @@index([driver_id, started_at])
  @@index([outcome, completed_at])
}

model driver_cash_accounts {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driver_id                String                     @unique @db.Uuid
  current_balance          Decimal                    @default(0) @db.Decimal(14, 2)
  created_at               DateTime                   @default(now()) @db.Timestamptz(3)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(3)
  drivers                  drivers                    @relation(fields: [driver_id], references: [id], onUpdate: NoAction)
  driver_cash_transactions driver_cash_transactions[]

  // FR.12A.3 — historical reconciliations of this account (evidence only).
  historical_reconciliations driver_cash_historical_reconciliations[]

  /// Composite-FK target: a historical reconciliation references (account_id, driver_id).
  @@unique([id, driver_id])
}

model driver_cash_transactions {
  id                             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id                     String                     @db.Uuid
  driver_id                      String                     @db.Uuid
  order_id                       String?                    @db.Uuid
  settlement_id                  String?                    @unique @db.Uuid
  type                           DriverCashTransactionType
  amount                         Decimal                    @db.Decimal(14, 2)
  balance_before                 Decimal                    @db.Decimal(14, 2)
  balance_after                  Decimal                    @db.Decimal(14, 2)
  created_by_id                  String?                    @db.Uuid
  notes                          String?
  reversal_of_id                 String?                    @db.Uuid
  idempotency_key                String?                    @unique @db.VarChar(200)
  created_at                     DateTime                   @default(now()) @db.Timestamptz(3)
  driver_cash_accounts           driver_cash_accounts       @relation(fields: [account_id], references: [id], onUpdate: NoAction)
  users                          users?                     @relation(fields: [created_by_id], references: [id], onUpdate: NoAction)
  drivers                        drivers                    @relation(fields: [driver_id], references: [id], onUpdate: NoAction)
  orders                         orders?                    @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  driver_cash_transactions       driver_cash_transactions?  @relation("driver_cash_transactionsTodriver_cash_transactions", fields: [reversal_of_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  other_driver_cash_transactions driver_cash_transactions[] @relation("driver_cash_transactionsTodriver_cash_transactions")
  driver_settlements             driver_settlements?        @relation(fields: [settlement_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // Settlement-Based Financial Release (FR.2) — inverse relations only.
  financial_release_collection order_financial_releases?            @relation("ofr_collection_transaction")
  settlement_correction        driver_settlement_corrections?       @relation("dsc_cash_transaction")
  release_correction_reversal  order_financial_release_corrections? @relation("ofrc_driver_cash_reversal")

  // FR.12A.3 — surviving rows anchoring a historical reconciliation gap.
  historical_reconciliation_predecessors driver_cash_historical_reconciliations[] @relation("dchr_predecessor_transaction")
  historical_reconciliation_anchors      driver_cash_historical_reconciliations[] @relation("dchr_anchor_transaction")

  /// Composite-FK target: reconciliation anchors reference (id, account_id).
  @@unique([id, account_id])

  @@index([account_id, created_at])
  @@index([driver_id, created_at])
  @@index([order_id])
  @@index([type, created_at])
}

model driver_settlements {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlement_number        String                    @unique @db.VarChar(50)
  driver_id                String                    @db.Uuid
  balance_before           Decimal                   @db.Decimal(14, 2)
  amount_received          Decimal                   @db.Decimal(14, 2)
  balance_after            Decimal                   @db.Decimal(14, 2)
  payment_method_id        String                    @db.Uuid
  received_by_id           String                    @db.Uuid
  notes                    String?
  created_at               DateTime                  @default(now()) @db.Timestamptz(3)
  /// Settlement-Based Financial Release (FR.2). All three NULL on a legacy-format
  /// settlement (every row created before FR.4, and any later request without
  /// allocations). SQL-only CHECKs: both amounts NULL together; when set, both >= 0 and
  /// amount_received = allocated_total + unattributed_amount; unattributed_amount > 0
  /// requires a non-blank unattributed_reason of at least 10 characters.
  allocated_total             Decimal?                        @db.Decimal(14, 2)
  unattributed_amount         Decimal?                        @db.Decimal(14, 2)
  unattributed_reason         String?
  driver_cash_transactions driver_cash_transactions?
  drivers                  drivers                   @relation(fields: [driver_id], references: [id], onUpdate: NoAction)
  payment_methods          payment_methods           @relation(fields: [payment_method_id], references: [id], onUpdate: NoAction)
  users                    users                     @relation(fields: [received_by_id], references: [id], onUpdate: NoAction)
  allocations                 driver_settlement_allocations[]
  corrections                 driver_settlement_corrections[]
  released_financial_releases order_financial_releases[]      @relation("ofr_released_by_settlement")
  historical_reconciliations  driver_cash_historical_reconciliations[] @relation("dchr_related_settlement")

  /// Composite-FK target: allocations and corrections reference (id, driver_id) so the
  /// database rejects a row whose driver differs from the settlement's driver.
  @@unique([id, driver_id])
  @@index([driver_id, created_at])
}

/// driver_number's default reads the `driver_number_seq` sequence (created in
/// migrations/, not visible to Prisma) — backend-generated, sequential,
/// concurrency-safe (Postgres nextval() is atomic). Never client-supplied.
model drivers {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String                     @unique @db.Uuid
  driver_number            String                     @unique @default(dbgenerated("('DRV-'::text || lpad((nextval('driver_number_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(50)
  is_active                Boolean                    @default(true)
  created_at               DateTime                   @default(now()) @db.Timestamptz(3)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(3)
  delivery_attempts        delivery_attempts[]
  company_direct_collections company_direct_collections[]
  driver_cash_accounts     driver_cash_accounts?
  driver_cash_transactions driver_cash_transactions[]
  driver_settlements       driver_settlements[]
  users                    users                      @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  order_assignments        order_assignments[]
  orders                   orders[]                       @relation("orders_current_driver")
  order_financial_releases   order_financial_releases[]

  parcel_collection_current_orders orders[]                       @relation("orders_current_parcel_collection_driver")
  parcel_collection_assignments    parcel_collection_assignments[]
  parcel_collection_attempts       parcel_collection_attempts[]

  // Driver Expenses module — Prisma inverse relations only (no columns on
  // drivers). See the driver_expense_* models below.
  driver_expense_profiles driver_expense_profiles?
  driver_daily_expenses   driver_daily_expenses[]

  @@index([is_active])
}

model employees {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @unique @db.Uuid
  employee_number String   @unique @db.VarChar(50)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @default(now()) @db.Timestamptz(3)
  users           users    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model failed_delivery_reasons {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique @db.VarChar(150)
  requires_notes    Boolean             @default(false)
  is_active         Boolean             @default(true)
  sort_order        Int                 @default(0)
  created_at        DateTime            @default(now()) @db.Timestamptz(3)
  updated_at        DateTime            @default(now()) @db.Timestamptz(3)
  delivery_attempts delivery_attempts[]

  @@index([is_active, sort_order])
}

// ============================================================
// Parcel Intake & Collection (Phase 11.17.2)
// Contract: docs/parcel-intake-collection-database-contract.md
// A different domain from financial "collection" (money from the receiver).
// ============================================================

/// Separate, configurable reason catalog for FAILED parcel-collection attempts.
/// NEVER merged with failed_delivery_reasons. Deactivate, do not hard-delete.
model failed_collection_reasons {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                      @unique @db.VarChar(150)
  requires_notes             Boolean                     @default(false)
  is_active                  Boolean                     @default(true)
  sort_order                 Int                         @default(0)
  created_at                 DateTime                    @default(now()) @db.Timestamptz(3)
  updated_at                 DateTime                    @default(now()) @db.Timestamptz(3)
  parcel_collection_attempts parcel_collection_attempts[]

  @@index([is_active, sort_order])
}

/// Permanent history of parcel-collection driver assignments — separate from
/// order_assignments (which stays DELIVERY-only). Exactly one current row per
/// order (SQL-only partial unique index
/// `parcel_collection_assignments_one_current_per_order_uq WHERE is_current`).
/// SQL-only CHECK `parcel_collection_assignments_current_state_chk`:
///   is_current <=> (ended_at IS NULL AND end_reason IS NULL).
/// current row is retained through COLLECTED_FROM_SENDER (driver keeps custody);
/// ended on reassign / failed collection / received-at-company / order cancel.
model parcel_collection_assignments {
  id             String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String                              @db.Uuid
  driver_id      String                              @db.Uuid
  assigned_by_id String                              @db.Uuid
  assigned_at    DateTime                            @default(now()) @db.Timestamptz(3)
  ended_at       DateTime?                           @db.Timestamptz(3)
  end_reason     ParcelCollectionAssignmentEndReason?
  is_current     Boolean                             @default(true)
  orders         orders                              @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  drivers        drivers                             @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assigned_by    users                               @relation(fields: [assigned_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([order_id, is_current])
  @@index([driver_id, is_current])
  @@index([assigned_at])
}

/// Permanent, append-only history of parcel-collection attempts — separate from
/// delivery_attempts. A retry inserts a new row; failed rows are never rewritten.
/// SQL-only partial unique index
/// `parcel_collection_attempts_one_collected_per_order_uq WHERE outcome = 'COLLECTED'`
/// enforces at most one successful collection per order.
model parcel_collection_attempts {
  id                          String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                    String                         @db.Uuid
  driver_id                   String                         @db.Uuid
  attempt_number              Int
  outcome                     ParcelCollectionAttemptOutcome
  failed_collection_reason_id String?                        @db.Uuid
  notes                       String?
  // V1 has no "start parcel collection" action — started_at stays NULL until a
  // future explicit start action exists (Phase 11.17.3 correction). completed_at
  // is the action time.
  started_at                  DateTime?                      @db.Timestamptz(3)
  completed_at                DateTime?                      @db.Timestamptz(3)
  created_at                  DateTime                       @default(now()) @db.Timestamptz(3)
  orders                      orders                         @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  drivers                     drivers                        @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  failed_collection_reasons   failed_collection_reasons?     @relation(fields: [failed_collection_reason_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([order_id, attempt_number])
  @@index([driver_id, started_at])
  @@index([outcome, completed_at])
}

model order_assignments {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String    @db.Uuid
  driver_id      String    @db.Uuid
  assigned_by_id String    @db.Uuid
  assigned_at    DateTime  @default(now()) @db.Timestamptz(3)
  ended_at       DateTime? @db.Timestamptz(3)
  end_reason     String?   @db.VarChar(500)
  is_current     Boolean   @default(true)
  users          users     @relation(fields: [assigned_by_id], references: [id], onUpdate: NoAction)
  drivers        drivers   @relation(fields: [driver_id], references: [id], onUpdate: NoAction)
  orders         orders    @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@index([assigned_at])
  @@index([driver_id, is_current])
  @@index([order_id, is_current])
}

model order_status_history {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String       @db.Uuid
  from_status   OrderStatus?
  to_status     OrderStatus
  changed_by_id String       @db.Uuid
  reason        String?      @db.VarChar(500)
  notes         String?
  created_at    DateTime     @default(now()) @db.Timestamptz(3)
  users         users        @relation(fields: [changed_by_id], references: [id], onUpdate: NoAction)
  orders        orders       @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@index([order_id, created_at])
  @@index([to_status, created_at])
}

model orders {
  id                                                                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number                                                         String                           @unique @db.VarChar(50)
  tracking_code                                                        String                           @unique @db.VarChar(100)
  customer_id                                                          String                           @db.Uuid
  created_by_id                                                        String                           @db.Uuid
  order_type                                                           OrderType
  status                                                               OrderStatus                      @default(RECEIVED)
  financial_status                                                     OrderFinancialStatus             @default(PENDING)
  receiver_name                                                        String                           @db.VarChar(200)
  receiver_phone                                                       String                           @db.VarChar(30)
