// ============================================================================
// DRIVER EXPENSES MODULE (Phase 1 — database only)
//
// Fully independent of every financial/operational module: no relation to
// orders, delivery, driver cash, settlements, wallets, payouts or company
// finance, and nothing here is ever posted to those ledgers. The ONLY
// external business-data reference is drivers.id (driver identity).
//
// Calculation (performed by the Driver Expenses backend, later phases):
//   price per liter      = price_per_20_liters / 20
//   fuel expense per km  = price per liter * consumption (L/100 km) / 100
//   daily expense        = distance_km * fuel expense per km
//                        = distance_km * price_per_20_liters * consumption * 0.0005
// CHECK constraints in the migration enforce positivity and that every daily
// row's estimated_expense equals that formula over its own snapshots (stored
// exactly — never rounded at rest).
// ============================================================================

enum DriverExpenseVehicleType {
  MOTORCYCLE
  CAR
}

// Append-only configuration history. The settings applicable to an expense
// date are the row with the greatest effective_from <= that date. A change is
// a NEW row with a new effective_from — existing rows (and the daily expenses
// that reference and snapshot them) are never rewritten.
model driver_fuel_settings {
  id                                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  price_per_20_liters                Decimal                 @db.Decimal(14, 2)
  motorcycle_consumption_l_per_100km Decimal                 @db.Decimal(6, 2)
  car_consumption_l_per_100km        Decimal                 @db.Decimal(6, 2)
  effective_from                     DateTime                @unique @db.Date
  created_at                         DateTime                @default(now()) @db.Timestamptz(3)
  driver_daily_expenses              driver_daily_expenses[]
}

// One per driver — the vehicle type a new daily expense defaults to. Holds no
// copy of driver identity data (name/phone live on drivers -> users).
model driver_expense_profiles {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driver_id            String                   @unique @db.Uuid
  default_vehicle_type DriverExpenseVehicleType
  created_at           DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at           DateTime                 @default(now()) @db.Timestamptz(3)
  drivers              drivers                  @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

// One row per driver per calendar date. The fuel price and the consumption
// rate of the vehicle type used are SNAPSHOTTED so a later settings change
// can never alter a recorded day.
model driver_daily_expenses {
  id                               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driver_id                        String                   @db.Uuid
  expense_date                     DateTime                 @db.Date
  vehicle_type                     DriverExpenseVehicleType
  distance_km                      Decimal                  @db.Decimal(8, 2)
  fuel_settings_id                 String                   @db.Uuid
  price_per_20_liters_snapshot     Decimal                  @db.Decimal(14, 2)
  consumption_l_per_100km_snapshot Decimal                  @db.Decimal(6, 2)
  estimated_expense                Decimal                  @db.Decimal(24, 10)
  notes                            String?
  created_at                       DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at                       DateTime                 @default(now()) @db.Timestamptz(3)
  drivers                          drivers                  @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  driver_fuel_settings             driver_fuel_settings     @relation(fields: [fuel_settings_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([driver_id, expense_date])
  @@index([expense_date])
  @@index([fuel_settings_id])
}

// ============================================================================
// SETTLEMENT-BASED FINANCIAL RELEASE (FR.2 — database only)
//
// Contract: docs/settlement-financial-release-contract.md (§3 schema, §4 state
// machines, §11 invariants). Business rules: docs/requirements.md §55.
// Migration: migrations/20261016000000_settlement_financial_release_foundation.
//
// Additive only: no existing row is modified or backfilled. Every historical
// order keeps financial_release_mode = NULL (legacy immediate processing) and
// every historical settlement keeps NULL allocation metadata. Every FK is
// ON DELETE RESTRICT. CHECK constraints and partial indexes exist only in the
// SQL migration (Prisma cannot express them) and are documented on each model.
// ============================================================================

enum FinancialReleaseMode {
  IMMEDIATE // activation ON; collection did not enter Driver Cash (bypass or zero cash)
  ON_SETTLEMENT // activation ON; collection entered Driver Cash
}

enum FinancialReleaseStatus {
  PENDING // collection recorded; no ownership posting yet
  RELEASED // wallet / company postings made
  VOIDED // collection reversed before any allocation; nothing ever posted (terminal)
  RELEASE_REVERSED // postings reversed by an explicit correction (terminal, no re-release)
}

enum FinancialReleaseReviewStatus {
  NOT_REQUIRED
  AWAITING_REVIEW
  RESOLVED
}

enum DriverSettlementCorrectionType {
  SETTLEMENT_REVERSAL // the settlement was recorded in error (at most one per settlement)
  SETTLEMENT_SHORTFALL // the driver genuinely handed over less than recorded
}

enum OrderFinancialReleaseCorrectionType {
  COLLECTION_VOID // the settlement-mode Driver Cash collection is reversed
  RELEASE_REVERSAL // released postings are reversed (mis-attribution)
}

/// One row per ON_SETTLEMENT order (created by /deliver). Holds the planned
/// ownership split and the settlement progress of that order's Driver Cash
/// COLLECTION. customer_id / order_type / delivered_at / driver_id are
/// deliberate immutable snapshots: pending-wallet aggregation by customer, the
/// order-type CHECKs, delivery-date reporting and the composite-FK target.
///
/// SQL-only constraints (migration):
///   ofr_collection_amount_positive_chk  collection_amount > 0
///   ofr_allocated_amount_range_chk      0 <= allocated_amount <= collection_amount
///   ofr_planned_presence_chk            planned amounts all NULL or all set; NULL <=> AWAITING_REVIEW
///   ofr_planned_values_chk              each >= 0 and their sum = collection_amount
///   ofr_order_type_buckets_chk          DELIVERY_ONLY: no product amount / posting;
///                                       COMPANY_ORDER: no wallet amount / posting
///   ofr_release_state_chk               per-status shape (§4.1): PENDING / VOIDED have no
///                                       release metadata or postings; RELEASED is fully
///                                       allocated; RELEASED / RELEASE_REVERSED are released
///                                       and review-cleared; VOIDED is unallocated
///   ofr_posted_transactions_chk         released rows carry exactly the postings of their
///                                       non-zero planned amounts
///   ofr_outstanding_idx (partial)       (driver_id, delivered_at, id)
///                                       WHERE release_status = 'PENDING' AND allocated_amount < collection_amount
model order_financial_releases {
  id                             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                       String                       @unique @db.Uuid
  customer_id                    String                       @db.Uuid
  driver_id                      String                       @db.Uuid
  collection_transaction_id      String                       @unique @db.Uuid
  order_type                     OrderType
  delivered_at                   DateTime                     @db.Timestamptz(3)
  collection_amount              Decimal                      @db.Decimal(14, 2)
  allocated_amount               Decimal                      @default(0) @db.Decimal(14, 2)
  review_status                  FinancialReleaseReviewStatus
  release_status                 FinancialReleaseStatus       @default(PENDING)
  planned_customer_wallet_amount Decimal?                     @db.Decimal(14, 2)
  planned_company_product_amount Decimal?                     @db.Decimal(14, 2)
  planned_company_fee_amount     Decimal?                     @db.Decimal(14, 2)
  wallet_transaction_id          String?                      @unique @db.Uuid
  company_product_transaction_id String?                      @unique @db.Uuid
  company_fee_transaction_id     String?                      @unique @db.Uuid
  released_at                    DateTime?                    @db.Timestamptz(3)
  released_by_id                 String?                      @db.Uuid
  /// NULL when the release was triggered by a collection-difference resolution.
  released_by_settlement_id      String?                      @db.Uuid
  created_at                     DateTime                     @default(now()) @db.Timestamptz(3)
  updated_at                     DateTime                     @default(now()) @db.Timestamptz(3)

  orders                      orders                               @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customers                   customers                            @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  drivers                     drivers                              @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  collection_transaction      driver_cash_transactions             @relation("ofr_collection_transaction", fields: [collection_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  wallet_transaction          wallet_transactions?                 @relation("ofr_wallet_transaction", fields: [wallet_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  company_product_transaction company_financial_transactions?      @relation("ofr_company_product_transaction", fields: [company_product_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  company_fee_transaction     company_financial_transactions?      @relation("ofr_company_fee_transaction", fields: [company_fee_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  released_by                 users?                               @relation("ofr_released_by", fields: [released_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  released_by_settlement      driver_settlements?                  @relation("ofr_released_by_settlement", fields: [released_by_settlement_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations                 driver_settlement_allocations[]
  correction                  order_financial_release_corrections?

  /// Composite-FK target for driver_settlement_allocations (release_id, driver_id).
  @@unique([id, driver_id])
  @@index([driver_id, release_status, delivered_at], map: "ofr_driver_id_release_status_delivered_at_idx")
  @@index([customer_id, release_status])
  @@index([release_status, review_status])
  @@index([delivered_at])
  @@index([released_at])
  @@index([released_by_settlement_id])
}

/// Explicit allocation of part of a settlement to one settlement-mode collection.
/// Append-only except the one-way ACTIVE -> REVERSED marker
/// (reversed_by_correction_id, set only by a SETTLEMENT_REVERSAL correction).
/// driver_id exists solely for the two composite FKs, which make the database
/// itself reject cross-driver allocation:
///   (settlement_id, driver_id) -> driver_settlements(id, driver_id)
///   (release_id,    driver_id) -> order_financial_releases(id, driver_id)
/// The order and its COLLECTION row are reached through release_id (not duplicated).
/// SQL-only CHECK: dsa_amount_positive_chk (amount > 0).
model driver_settlement_allocations {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlement_id             String   @db.Uuid
  release_id                String   @db.Uuid
  driver_id                 String   @db.Uuid
  amount                    Decimal  @db.Decimal(14, 2)
  created_by_id             String   @db.Uuid
  created_at                DateTime @default(now()) @db.Timestamptz(3)
  reversed_by_correction_id String?  @db.Uuid

  driver_settlements     driver_settlements             @relation(fields: [settlement_id, driver_id], references: [id, driver_id], onDelete: Restrict, onUpdate: NoAction)
  release                order_financial_releases       @relation(fields: [release_id, driver_id], references: [id, driver_id], onDelete: Restrict, onUpdate: NoAction)
  created_by             users                          @relation(fields: [created_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversed_by_correction driver_settlement_corrections? @relation(fields: [reversed_by_correction_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([settlement_id, release_id])
  @@index([release_id])
  @@index([driver_id, created_at])
  @@index([reversed_by_correction_id])
}

/// Explicit, reasoned, idempotent correction of a settlement (legacy or
/// allocation-format). cash_transaction_id is the corrective Driver Cash row:
/// REVERSAL (SETTLEMENT_REVERSAL) or ADJUSTMENT credit (SETTLEMENT_SHORTFALL).
/// The original settlement and its SETTLEMENT cash row are never modified.
/// SQL-only constraints:
///   dsc_amount_positive_chk         amount > 0
///   dsc_reason_not_blank_chk        length(btrim(reason)) > 0 (the legacy generic reversal
///                                   endpoint also writes here; the >= 10-character rule for
///                                   the new correction endpoints lives in their schemas)
///   dsc_idempotency_key_not_blank_chk
///   dsc_one_reversal_per_settlement_uq (partial unique)
///                                   (settlement_id) WHERE correction_type = 'SETTLEMENT_REVERSAL'
model driver_settlement_corrections {
  id                  String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlement_id       String                         @db.Uuid
  driver_id           String                         @db.Uuid
  correction_type     DriverSettlementCorrectionType
  amount              Decimal                        @db.Decimal(14, 2)
  reason              String
  cash_transaction_id String                         @unique @db.Uuid
  created_by_id       String                         @db.Uuid
  idempotency_key     String                         @unique @db.VarChar(200)
  created_at          DateTime                       @default(now()) @db.Timestamptz(3)

  driver_settlements   driver_settlements              @relation(fields: [settlement_id, driver_id], references: [id, driver_id], onDelete: Restrict, onUpdate: NoAction)
  cash_transaction     driver_cash_transactions        @relation("dsc_cash_transaction", fields: [cash_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by           users                           @relation(fields: [created_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversed_allocations driver_settlement_allocations[]

  @@index([settlement_id])
  @@index([driver_id, created_at])
}

/// Explicit, reasoned, idempotent terminal correction of one release (at most one
/// per release — release_id UNIQUE). The order is reached through release_id.
/// Corrective rows reuse the existing reversal primitives / keys.
/// SQL-only constraints:
///   ofrc_reason_meaningful_chk  length(btrim(reason)) >= 10
///   ofrc_idempotency_key_not_blank_chk
///   ofrc_type_shape_chk        COLLECTION_VOID: Driver Cash reversal set, no wallet/company
///                               reversal; RELEASE_REVERSAL: no Driver Cash reversal, at least
///                               one wallet/company reversal
model order_financial_release_corrections {
  id                                      String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  release_id                              String                              @unique @db.Uuid
  correction_type                         OrderFinancialReleaseCorrectionType
  reason                                  String
  driver_cash_reversal_transaction_id     String?                             @unique(map: "ofrc_driver_cash_reversal_transaction_id_key") @db.Uuid
  wallet_reversal_transaction_id          String?                             @unique(map: "ofrc_wallet_reversal_transaction_id_key") @db.Uuid
  company_product_reversal_transaction_id String?                             @unique(map: "ofrc_company_product_reversal_transaction_id_key") @db.Uuid
  company_fee_reversal_transaction_id     String?                             @unique(map: "ofrc_company_fee_reversal_transaction_id_key") @db.Uuid
  created_by_id                           String                              @db.Uuid
  idempotency_key                         String                              @unique @db.VarChar(200)
  created_at                              DateTime                            @default(now()) @db.Timestamptz(3)

  release                              order_financial_releases        @relation(fields: [release_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  driver_cash_reversal_transaction     driver_cash_transactions?       @relation("ofrc_driver_cash_reversal", fields: [driver_cash_reversal_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ofrc_driver_cash_reversal_transaction_id_fkey")
  wallet_reversal_transaction          wallet_transactions?            @relation("ofrc_wallet_reversal", fields: [wallet_reversal_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ofrc_wallet_reversal_transaction_id_fkey")
  company_product_reversal_transaction company_financial_transactions? @relation("ofrc_company_product_reversal", fields: [company_product_reversal_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ofrc_company_product_reversal_transaction_id_fkey")
  company_fee_reversal_transaction     company_financial_transactions? @relation("ofrc_company_fee_reversal", fields: [company_fee_reversal_transaction_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ofrc_company_fee_reversal_transaction_id_fkey")
  created_by                           users                           @relation(fields: [created_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([correction_type, created_at], map: "ofrc_correction_type_created_at_idx")
}

// ============================================================================
// FR.12A.3 — Driver cash historical reconciliation (evidence only)
// Design: docs/fr12a2-historical-ledger-reconciliation-design.md, refined in
// docs/fr12a3-historical-reconciliation-foundation.md.
// Migration: migrations/20261025000000_driver_cash_historical_reconciliation_foundation.
//
// Additive only. A reconciliation explains one located gap in a driver cash
// ledger; it never moves cash, never posts wallet credit or company revenue and
// never decides who owns the money (ownership_status stays UNRESOLVED). G3 / R1
// are NOT changed by these tables (FR.12A.4). No triggers: immutability comes
// from the evidence-digest CHECK plus ON UPDATE RESTRICT composite FKs, and the
// lifecycle is append-only decision rows (status is derived, never stored).
// CHECK constraints and partial indexes exist only in the SQL migration.
// ============================================================================

enum FinancialLedgerIncidentCause {
  MANUAL_DATABASE_DELETION
}

enum DriverCashHistoricalReconciliationKind {
  MISSING_COLLECTION // a deleted driver cash COLLECTION named by a surviving COLLECTION_DIFFERENCE_RECORDED audit
}

enum HistoricalReconciliationAccountingTreatment {
  EVIDENCE_ONLY_NO_CASH_EFFECT
}

enum HistoricalOwnershipStatus {
  UNRESOLVED // only value; resolving ownership needs its own approved design (FR.12A.2 D4)
}

enum HistoricalReconciliationDecisionType {
  APPROVED // independent reviewer accepts the evidence (not terminal: may be REVOKED)
  REJECTED // independent reviewer refuses the evidence (terminal)
  WITHDRAWN // proposal withdrawn before review (terminal)
  REVOKED // a previous APPROVED decision is ended (terminal)
}

/// A documented ledger incident (cause, scope, missing records, uncertainties,
/// query evidence). Immutable: never updated or deleted by the application.
/// Free text must not contain customer / receiver personal data.
/// SQL-only CHECKs: fli_incident_number_format_chk (LI-YYYY-NNNN),
/// fli_summary_meaningful_chk (>= 20 chars), fli_uncertainties_not_blank_chk,
/// fli_occurrence_window_chk, fli_missing_records_object_chk, fli_evidence_object_chk.
model financial_ledger_incidents {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incident_number         String                       @unique @db.VarChar(30)
  cause                   FinancialLedgerIncidentCause
  summary                 String
  discovered_at           DateTime                     @db.Timestamptz(3)
  occurred_not_before     DateTime?                    @db.Timestamptz(3)
  occurred_not_after      DateTime?                    @db.Timestamptz(3)
  /// Per table: a count or "unknown", e.g. { "orders": 1, "delivery_attempts": "unknown" }.
  missing_records         Json
  remaining_uncertainties String
  /// Query ids, run timestamps, result digests and reviewer of the investigation.
  evidence                Json
  reported_by_id          String                       @db.Uuid
  created_at              DateTime                     @default(now()) @db.Timestamptz(3)

  reported_by     users                                    @relation("fli_reported_by", fields: [reported_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reconciliations driver_cash_historical_reconciliations[]
  ownership_resolutions historical_ownership_resolutions[]
}

/// One immutable proposal explaining ONE located balance-chain gap of one driver
/// cash account: the missing COLLECTION (missing_transaction_id, no FK - it was
/// deleted) between predecessor (NULL = gap at the start) and anchor, evidenced by
/// the surviving COLLECTION_DIFFERENCE_RECORDED audit. Status is derived from
/// driver_cash_historical_reconciliation_decisions (no decision = PROPOSED).
/// A re-proposal of the same evidence supersedes a record that has a terminal
/// decision; each evidence chain is linear, so at most one record is live.
/// The evidence time is the source audit's created_at (no stored copy: see the
/// digest note in the migration).
///
/// SQL-only constraints (migration):
///   dchr_amount_positive_chk, dchr_observed_jump_matches_chk (= amount),
///   dchr_actual_amount_matches_chk (MISSING_COLLECTION: actual_amount = amount),
///   dchr_expected_amount_chk (>= 0),
///   dchr_collection_difference_chk (= actual - expected, <> 0),
///   dchr_anchor_not_predecessor_chk, dchr_ownership_unresolved_chk,
///   dchr_reason_meaningful_chk (>= 20 chars), dchr_idempotency_key_not_blank_chk,
///   dchr_supersession_shape_chk (all three supersedes_* NULL, or all set with terminal = true),
///   dchr_evidence_digest_chk   evidence_digest = sha256 of the canonical v1 evidence string
///                              (buildEvidenceCanonicalString mirrors it exactly)
///   dchr_root_anchor_uq / dchr_root_missing_transaction_uq / dchr_root_source_audit_uq (partial)
///                              UNIQUE (...) WHERE supersedes_reconciliation_id IS NULL
model driver_cash_historical_reconciliations {
  id                              String                                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incident_id                     String                                      @db.Uuid
  account_id                      String                                      @db.Uuid
  driver_id                       String                                      @db.Uuid
  kind                            DriverCashHistoricalReconciliationKind
  accounting_treatment            HistoricalReconciliationAccountingTreatment
  ownership_status                HistoricalOwnershipStatus
  /// Signed net movement of the missing rows (MISSING_COLLECTION: > 0).
  amount                          Decimal                                     @db.Decimal(14, 2)
  /// anchor.balance_before - coalesce(predecessor.balance_after, 0) at proposal.
  observed_jump                   Decimal                                     @db.Decimal(14, 2)
  predecessor_transaction_id      String?                                     @db.Uuid
  anchor_transaction_id           String                                      @db.Uuid
  missing_transaction_id          String                                      @db.Uuid
  source_audit_log_id             String                                      @db.Uuid
  /// The deleted order's id (audit entity_id). No FK: the order no longer exists.
  deleted_order_reference         String                                      @db.Uuid
  order_type                      OrderType
  expected_amount                 Decimal                                     @db.Decimal(14, 2)
  actual_amount                   Decimal                                     @db.Decimal(14, 2)
  collection_difference           Decimal                                     @db.Decimal(14, 2)
  related_settlement_id           String?                                     @db.Uuid
  evidence_digest                 String                                      @db.Char(64)
  reason                          String
  proposed_by_id                  String                                      @db.Uuid
  idempotency_key                 String                                      @unique(map: "dchr_idempotency_key_key") @db.VarChar(200)
  supersedes_reconciliation_id    String?                                     @unique(map: "dchr_supersedes_reconciliation_id_key") @db.Uuid
  supersedes_decision_id          String?                                     @db.Uuid
  supersedes_decision_is_terminal Boolean?
  created_at                      DateTime                                    @default(now()) @db.Timestamptz(3)

  incident                financial_ledger_incidents                        @relation(fields: [incident_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_incident_id_fkey")
  account                 driver_cash_accounts                              @relation(fields: [account_id, driver_id], references: [id, driver_id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_account_id_driver_id_fkey")
  predecessor_transaction driver_cash_transactions?                         @relation("dchr_predecessor_transaction", fields: [predecessor_transaction_id, account_id], references: [id, account_id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_predecessor_transaction_fkey")
  anchor_transaction      driver_cash_transactions                          @relation("dchr_anchor_transaction", fields: [anchor_transaction_id, account_id], references: [id, account_id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_anchor_transaction_fkey")
  source_audit_log        audit_logs                                        @relation("dchr_source_audit_log", fields: [source_audit_log_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_source_audit_log_id_fkey")
  related_settlement      driver_settlements?                               @relation("dchr_related_settlement", fields: [related_settlement_id, driver_id], references: [id, driver_id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_related_settlement_fkey")
  proposed_by             users                                             @relation("dchr_proposed_by", fields: [proposed_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_proposed_by_id_fkey")
  decisions               driver_cash_historical_reconciliation_decisions[]
  /// FR.12A.9 — ownership resolutions citing this reconciliation as collection evidence.
  ownership_resolutions   historical_ownership_resolutions[]
  /// A re-proposal explains exactly the same gap, missing row and audit
  /// (composite FK on the evidence keys) ...
  supersedes              driver_cash_historical_reconciliations?           @relation("dchr_supersedes", fields: [supersedes_reconciliation_id, account_id, anchor_transaction_id, missing_transaction_id, source_audit_log_id], references: [id, account_id, anchor_transaction_id, missing_transaction_id, source_audit_log_id], onDelete: Restrict, onUpdate: NoAction, map: "dchr_supersedes_reconciliation_fkey")
  /// ... and cites a TERMINAL decision (REJECTED / WITHDRAWN / REVOKED) of the
  /// record it supersedes, so a live record never gains a sibling.
  supersedes_decision     driver_cash_historical_reconciliation_decisions?  @relation("dchr_supersedes_decision", fields: [supersedes_decision_id, supersedes_reconciliation_id, supersedes_decision_is_terminal], references: [id, reconciliation_id, is_terminal], onDelete: Restrict, onUpdate: Restrict, map: "dchr_supersedes_terminal_decision_fkey")
  /// At most one element: supersedes_reconciliation_id is UNIQUE.
  superseded_by           driver_cash_historical_reconciliations[]          @relation("dchr_supersedes")

  /// FK target binding every decision to this proposer and evidence (ON UPDATE RESTRICT).
  @@unique([id, proposed_by_id, evidence_digest], map: "dchr_id_proposed_by_id_evidence_digest_key")
  /// FK target for supersession (a re-proposal keeps the same evidence keys).
  @@unique([id, account_id, anchor_transaction_id, missing_transaction_id, source_audit_log_id], map: "dchr_id_evidence_keys_key")
  @@index([account_id, created_at], map: "dchr_account_id_created_at_idx")
  @@index([incident_id], map: "dchr_incident_id_idx")
  @@index([supersedes_decision_id], map: "dchr_supersedes_decision_id_idx")
}

/// Append-only lifecycle of a reconciliation. Never updated or deleted by the
/// application. proposed_by_id and evidence_digest are copies pinned by the
/// composite FK (reconciliation_id, proposed_by_id, evidence_digest) ON UPDATE
/// RESTRICT, so a decision always refers to the exact evidence it judged and the
/// reconciliation's evidence is frozen once any decision exists.
///
/// SQL-only constraints (migration):
///   dchrd_is_terminal_chk            is_terminal = (decision <> 'APPROVED')
///   dchrd_independent_reviewer_chk   APPROVED / REJECTED: decided_by_id <> proposed_by_id
///   dchrd_revocation_shape_chk       REVOKED <=> revokes_decision_id set; revokes_decision_type = 'APPROVED'
///   dchrd_reason_chk                 APPROVED: optional note; otherwise reason >= 20 chars
///   dchrd_idempotency_key_not_blank_chk
///   dchrd_one_outcome_per_reconciliation_uq (partial)
///                                    UNIQUE (reconciliation_id) WHERE decision IN (APPROVED, REJECTED, WITHDRAWN)
model driver_cash_historical_reconciliation_decisions {
  id                    String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reconciliation_id     String                                @db.Uuid
  decision              HistoricalReconciliationDecisionType
  is_terminal           Boolean
  proposed_by_id        String                                @db.Uuid
  evidence_digest       String                                @db.Char(64)
  revokes_decision_id   String?                               @unique(map: "dchrd_revokes_decision_id_key") @db.Uuid
  revokes_decision_type HistoricalReconciliationDecisionType?
  decided_by_id         String                                @db.Uuid
  reason                String?
  idempotency_key       String                                @unique(map: "dchrd_idempotency_key_key") @db.VarChar(200)
  created_at            DateTime                              @default(now()) @db.Timestamptz(3)

  reconciliation              driver_cash_historical_reconciliations            @relation(fields: [reconciliation_id, proposed_by_id, evidence_digest], references: [id, proposed_by_id, evidence_digest], onDelete: Restrict, onUpdate: Restrict, map: "dchrd_reconciliation_evidence_fkey")
  revokes                     driver_cash_historical_reconciliation_decisions?  @relation("dchrd_revokes", fields: [revokes_decision_id, reconciliation_id, revokes_decision_type], references: [id, reconciliation_id, decision], onDelete: Restrict, onUpdate: Restrict, map: "dchrd_revokes_decision_fkey")
  /// At most one element: revokes_decision_id is UNIQUE.
  revoked_by                  driver_cash_historical_reconciliation_decisions[] @relation("dchrd_revokes")
  superseding_reconciliations driver_cash_historical_reconciliations[]          @relation("dchr_supersedes_decision")
  decided_by                  users                                             @relation("dchrd_decided_by", fields: [decided_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "dchrd_decided_by_id_fkey")

  /// FK targets: revocation (id, reconciliation_id, decision) and supersession
  /// (id, reconciliation_id, is_terminal).
  @@unique([id, reconciliation_id, decision], map: "dchrd_id_reconciliation_id_decision_key")
  @@unique([id, reconciliation_id, is_terminal], map: "dchrd_id_reconciliation_id_is_terminal_key")
  @@index([reconciliation_id, created_at], map: "dchrd_reconciliation_id_created_at_idx")
  @@index([decided_by_id], map: "dchrd_decided_by_id_idx")
}

// ============================================================
// FR.12A.9 — Historical ownership resolution: company-assumed historical
// liability. Migration 20261026000000_historical_ownership_liability_foundation;
// design docs/fr12a7b-company-assumed-historical-liability-design.md.
// A recorded liability is a separate sub-ledger: it never creates a wallet
// credit, driver cash movement, payout, settlement or company revenue.
// ============================================================

enum HistoricalOwnershipOutcome {
  COMPANY_ASSUMED_LIABILITY // the company recognizes an obligation to an unidentified beneficiary
}

enum HistoricalCollectionVerification {
  APPROVED_LEDGER_RECONCILIATION // the only route: an approved, valid ledger reconciliation whose anchor is the full settlement that handed the collection over
}

enum HistoricalOwnershipEvidenceKind {
  INVESTIGATION_REPORT
  FINANCE_MEMO
  BACKUP_EXTRACT
  ORDER_DOCUMENT
  CUSTOMER_STATEMENT
  CORRESPONDENCE
  OTHER
}

/// Immutable, versioned Finance policy for historical ownership outcomes. The
/// document itself lives outside the database (SHA-256 + reference). Status is
/// derived from historical_liability_policy_decisions.
model historical_liability_policies {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policy_code                 String                     @db.VarChar(60)
  version                     Int
  outcome                     HistoricalOwnershipOutcome
  title                       String
  summary                     String
  document_sha256             String                     @db.Char(64)
  document_reference          String
  /// L7: periodic Finance review interval; NULL = none configured.
  review_interval_days        Int?
  unclaimed_funds_handling    String
  /// L7: when an outstanding liability becomes due for unclaimed-funds review; NULL = none. No legal expiry is assumed.
  unclaimed_review_after_days Int?
  content_sha256              String                     @db.Char(64)
  /// SQL-only CHECK hlp_policy_digest_chk recomputes it.
  policy_digest               String                     @db.Char(64)
  proposed_by_id              String                     @db.Uuid
  idempotency_key             String                     @unique(map: "hlp_idempotency_key_key") @db.VarChar(200)
  created_at                  DateTime                   @default(now()) @db.Timestamptz(3)

  proposed_by users                                   @relation("hlp_proposed_by", fields: [proposed_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hlp_proposed_by_id_fkey")
  decisions   historical_liability_policy_decisions[]
  resolutions historical_ownership_resolutions[]

  @@unique([policy_code, version], map: "hlp_policy_code_version_key")
  @@unique([id, proposed_by_id, policy_digest], map: "hlp_id_proposed_by_id_policy_digest_key")
  @@unique([id, policy_digest], map: "hlp_id_policy_digest_key")
}

/// Append-only policy lifecycle (APPROVED / REJECTED by FINANCE != proposer;
/// WITHDRAWN; REVOKED by an ADMIN who is neither proposer nor approver - DB CHECK).
model historical_liability_policy_decisions {
  id                    String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policy_id             String                                @db.Uuid
  decision              HistoricalReconciliationDecisionType
  is_terminal           Boolean
  proposed_by_id        String                                @db.Uuid
  policy_digest         String                                @db.Char(64)
  revokes_decision_id   String?                               @unique(map: "hlpd_revokes_decision_id_key") @db.Uuid
  revokes_decision_type HistoricalReconciliationDecisionType?
  revoked_approver_id   String?                               @db.Uuid
  decided_by_id         String                                @db.Uuid
  reason                String?
  idempotency_key       String                                @unique(map: "hlpd_idempotency_key_key") @db.VarChar(200)
  created_at            DateTime                              @default(now()) @db.Timestamptz(3)

  policy     historical_liability_policies           @relation(fields: [policy_id, proposed_by_id, policy_digest], references: [id, proposed_by_id, policy_digest], onDelete: Restrict, onUpdate: Restrict, map: "hlpd_policy_digest_fkey")
  revokes    historical_liability_policy_decisions?  @relation("hlpd_revokes", fields: [revokes_decision_id, policy_id, revokes_decision_type, revoked_approver_id], references: [id, policy_id, decision, decided_by_id], onDelete: Restrict, onUpdate: Restrict, map: "hlpd_revokes_decision_fkey")
  revoked_by historical_liability_policy_decisions[] @relation("hlpd_revokes")
  decided_by users                                   @relation("hlpd_decided_by", fields: [decided_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hlpd_decided_by_id_fkey")

  @@unique([id, policy_id, decision, decided_by_id], map: "hlpd_id_policy_decision_decider_key")
  @@index([policy_id, created_at], map: "hlpd_policy_id_created_at_idx")
}

/// One immutable proposal resolving the ownership of ONE deleted order whose
/// collection difference was never resolved. Amounts are snapshots of the
/// surviving audit; L1 (held = collected) and L2 (tracked shortfall) are DB
/// CHECKs. Status is derived from historical_ownership_resolution_decisions.
model historical_ownership_resolutions {
  id                              String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incident_id                     String                           @db.Uuid
  outcome                         HistoricalOwnershipOutcome
  policy_id                       String                           @db.Uuid
  policy_digest                   String                           @db.Char(64)
  /// The deleted order's id (audit entity_id). No FK: the order no longer exists.
  deleted_order_reference         String                           @db.Uuid
  source_audit_log_id             String                           @db.Uuid
  order_type                      OrderType
  expected_amount                 Decimal                          @db.Decimal(14, 2)
  collected_amount                Decimal                          @db.Decimal(14, 2)
  collection_difference           Decimal                          @db.Decimal(14, 2)
  verification                    HistoricalCollectionVerification
  ledger_reconciliation_id        String                           @db.Uuid
  held_collection_amount          Decimal                          @db.Decimal(14, 2)
  tracked_shortfall_amount        Decimal                          @db.Decimal(14, 2)
  evidence_manifest_digest        String                           @db.Char(64)
  evidence_count                  Int
  rationale                       String
  rationale_digest                String                           @db.Char(64)
  /// SQL-only CHECK hor_resolution_digest_chk recomputes it.
  resolution_digest               String                           @db.Char(64)
  proposed_by_id                  String                           @db.Uuid
  idempotency_key                 String                           @unique(map: "hor_idempotency_key_key") @db.VarChar(200)
  supersedes_resolution_id        String?                          @unique(map: "hor_supersedes_resolution_id_key") @db.Uuid
  supersedes_decision_id          String?                          @db.Uuid
  supersedes_decision_is_terminal Boolean?
  created_at                      DateTime                         @default(now()) @db.Timestamptz(3)

  incident              financial_ledger_incidents                  @relation(fields: [incident_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hor_incident_id_fkey")
  policy                historical_liability_policies               @relation(fields: [policy_id, policy_digest], references: [id, policy_digest], onDelete: Restrict, onUpdate: Restrict, map: "hor_policy_digest_fkey")
  source_audit_log      audit_logs                                  @relation("hor_source_audit_log", fields: [source_audit_log_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hor_source_audit_log_id_fkey")
  ledger_reconciliation driver_cash_historical_reconciliations      @relation(fields: [ledger_reconciliation_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hor_ledger_reconciliation_id_fkey")
  proposed_by           users                                       @relation("hor_proposed_by", fields: [proposed_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hor_proposed_by_id_fkey")
  evidence              historical_ownership_resolution_evidence[]
  decisions             historical_ownership_resolution_decisions[]
  supersedes            historical_ownership_resolutions?           @relation("hor_supersedes", fields: [supersedes_resolution_id, deleted_order_reference], references: [id, deleted_order_reference], onDelete: Restrict, onUpdate: NoAction, map: "hor_supersedes_resolution_fkey")
  superseded_by         historical_ownership_resolutions[]          @relation("hor_supersedes")
  supersedes_decision   historical_ownership_resolution_decisions?  @relation("hor_supersedes_decision", fields: [supersedes_decision_id, supersedes_resolution_id, supersedes_decision_is_terminal], references: [id, resolution_id, is_terminal], onDelete: Restrict, onUpdate: Restrict, map: "hor_supersedes_terminal_decision_fkey")
  /// At most one element: historical_liabilities.resolution_id is UNIQUE.
  liabilities             historical_liabilities[]

  @@unique([id, proposed_by_id, resolution_digest], map: "hor_id_proposed_by_id_resolution_digest_key")
  @@unique([id, proposed_by_id, resolution_digest, held_collection_amount, tracked_shortfall_amount], map: "hor_id_liability_binding_key")
  @@unique([id, deleted_order_reference], map: "hor_id_deleted_order_reference_key")
  @@index([incident_id], map: "hor_incident_id_idx")
  @@index([policy_id], map: "hor_policy_id_idx")
  @@index([supersedes_decision_id], map: "hor_supersedes_decision_id_idx")
}

/// Immutable evidence fingerprints of a resolution (documents stay outside the
/// database). Their manifest digest is part of the resolution digest.
model historical_ownership_resolution_evidence {
  id              String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resolution_id   String                          @db.Uuid
  ordinal         Int
  kind            HistoricalOwnershipEvidenceKind
  document_sha256 String                          @db.Char(64)
  reference       String
  description     String
  created_at      DateTime                        @default(now()) @db.Timestamptz(3)

  resolution historical_ownership_resolutions @relation(fields: [resolution_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hore_resolution_id_fkey")

  @@unique([resolution_id, ordinal], map: "hore_resolution_ordinal_key")
  @@unique([resolution_id, document_sha256], map: "hore_resolution_document_key")
}

/// Append-only resolution lifecycle (same rules as the policy decisions).
model historical_ownership_resolution_decisions {
  id                    String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resolution_id         String                                @db.Uuid
  decision              HistoricalReconciliationDecisionType
  is_terminal           Boolean
  proposed_by_id        String                                @db.Uuid
  resolution_digest     String                                @db.Char(64)
  revokes_decision_id   String?                               @unique(map: "hord_revokes_decision_id_key") @db.Uuid
  revokes_decision_type HistoricalReconciliationDecisionType?
  revoked_approver_id   String?                               @db.Uuid
  decided_by_id         String                                @db.Uuid
  reason                String?
  idempotency_key       String                                @unique(map: "hord_idempotency_key_key") @db.VarChar(200)
  created_at            DateTime                              @default(now()) @db.Timestamptz(3)

  resolution             historical_ownership_resolutions            @relation(fields: [resolution_id, proposed_by_id, resolution_digest], references: [id, proposed_by_id, resolution_digest], onDelete: Restrict, onUpdate: Restrict, map: "hord_resolution_digest_fkey")
  revokes                historical_ownership_resolution_decisions?  @relation("hord_revokes", fields: [revokes_decision_id, resolution_id, revokes_decision_type, revoked_approver_id], references: [id, resolution_id, decision, decided_by_id], onDelete: Restrict, onUpdate: Restrict, map: "hord_revokes_decision_fkey")
  revoked_by             historical_ownership_resolution_decisions[] @relation("hord_revokes")
  superseding_resolutions historical_ownership_resolutions[]         @relation("hor_supersedes_decision")
  decided_by             users                                       @relation("hord_decided_by", fields: [decided_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hord_decided_by_id_fkey")
  liabilities            historical_liabilities[]

  @@unique([id, resolution_id, decision, decided_by_id], map: "hord_id_resolution_decision_decider_key")
  @@unique([id, resolution_id, is_terminal], map: "hord_id_resolution_id_is_terminal_key")
  @@index([resolution_id, created_at], map: "hord_resolution_id_created_at_idx")
}

/// The historical liability register: one row per approved resolution,
/// recorded separately from approval by a third person (D8). Amounts and the
/// approval are pinned by composite FKs; recognized = held (L1); the tracked
/// shortfall is never recognized (L2). Outstanding = recognized while no
/// discharge workflow exists (discharges await Finance decision L4).
model historical_liabilities {
  id                       String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resolution_id            String                               @unique(map: "hl_resolution_id_key") @db.Uuid
  proposed_by_id           String                               @db.Uuid
  resolution_digest        String                               @db.Char(64)
  approval_decision_id     String                               @db.Uuid
  approval_decision_type   HistoricalReconciliationDecisionType
  approved_by_id           String                               @db.Uuid
  held_collection_amount   Decimal                              @db.Decimal(14, 2)
  tracked_shortfall_amount Decimal                              @db.Decimal(14, 2)
  recognized_amount        Decimal                              @db.Decimal(14, 2)
  /// SQL-only CHECK hl_liability_digest_chk recomputes it.
  liability_digest         String                               @db.Char(64)
  recorded_by_id           String                               @db.Uuid
  idempotency_key          String                               @unique(map: "hl_idempotency_key_key") @db.VarChar(200)
  created_at               DateTime                             @default(now()) @db.Timestamptz(3)

  resolution  historical_ownership_resolutions          @relation(fields: [resolution_id, proposed_by_id, resolution_digest, held_collection_amount, tracked_shortfall_amount], references: [id, proposed_by_id, resolution_digest, held_collection_amount, tracked_shortfall_amount], onDelete: Restrict, onUpdate: Restrict, map: "hl_resolution_binding_fkey")
  approval    historical_ownership_resolution_decisions @relation(fields: [approval_decision_id, resolution_id, approval_decision_type, approved_by_id], references: [id, resolution_id, decision, decided_by_id], onDelete: Restrict, onUpdate: Restrict, map: "hl_approval_decision_fkey")
  recorded_by users                                     @relation("hl_recorded_by", fields: [recorded_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hl_recorded_by_id_fkey")
  reviews     historical_liability_reviews[]

  @@index([created_at], map: "hl_created_at_idx")
}

/// Append-only periodic Finance reviews of an outstanding liability (L7).
model historical_liability_reviews {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  liability_id    String   @db.Uuid
  reviewed_by_id  String   @db.Uuid
  note            String
  idempotency_key String   @unique(map: "hlr_idempotency_key_key") @db.VarChar(200)
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  liability   historical_liabilities @relation(fields: [liability_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hlr_liability_id_fkey")
  reviewed_by users                  @relation("hlr_reviewed_by", fields: [reviewed_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "hlr_reviewed_by_id_fkey")

  @@index([liability_id, created_at], map: "hlr_liability_id_created_at_idx")
}
